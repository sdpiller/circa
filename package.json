{
  "name": "chronoglobe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "etl:fetch": "node --env-file-if-exists=.env.local etl/fetch.ts",
    "audit": "node etl/audit.ts",
    "etl:boundaries": "node --env-file-if-exists=.env.local etl/boundaries.ts",
    "etl:load": "node etl/load.ts",
    "etl": "npm run etl:fetch && npm run etl:boundaries && npm run etl:load",
    "bench:area": "node etl/bench-area.ts",
    "story:publish": "node etl/story-publish.ts",
    "story:check": "node etl/story-check.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "maplibre-gl": "6.16.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module"
}
