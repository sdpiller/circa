# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic API key for narratives (Phase 5)
ANTHROPIC_API_KEY=
# Model for narratives. Verify the current name in the Anthropic docs.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Contact for the User-Agent on Wikimedia requests (required by their policy). Email or URL.
WIKIMEDIA_CONTACT=

# Basemap style URL from a provider with a free tier (Phase 3). Do not use the public OSM tile servers.
BASEMAP_STYLE_URL=
