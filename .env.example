# Copy to .env.local and fill in. Never commit .env.local.

# Contact for the User-Agent on Wikimedia requests (required by their policy). Email or URL.
# Also needed by the area box: without it /api/summary returns 503 and paragraphs and hover cards do not load.
WIKIMEDIA_CONTACT=

# Basemap style URL from a provider with a free tier. Do not use the public OSM tile servers.
# Optional: unset means OpenFreeMap's positron style (free, no key), recoloured to cream in the browser.
# The recolouring and names-by-zoom rules expect OpenMapTiles layer names (label_country_1, label_city, and so on).
# A style without them keeps its own colours and labels, with no error.
# Read at build time, so rebuild after changing it.
BASEMAP_STYLE_URL=
