# Copy to .env.local and fill in. Never commit .env.local.

# Contact for the User-Agent on Wikimedia requests (required by their policy). Email or URL.
# Also needed by the area box: without it /api/summary returns 503 and paragraphs and hover cards do not load.
WIKIMEDIA_CONTACT=

# Basemap style URL from a provider with a free tier. Do not use the public OSM tile servers.
# Optional: unset means OpenFreeMap's dark style (free, no key). Read at build time, so rebuild after changing it.
# Stack counts on the map use the "Noto Sans Bold" font from the basemap style; a style without it shows stacks without numbers.
# The dot colours were validated against a near-black basemap; re-validate before switching to a light style.
BASEMAP_STYLE_URL=
